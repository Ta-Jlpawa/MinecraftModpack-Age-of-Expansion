{
  "dragonDifficulty": {
    // Sets the dragon difficulty modifier, the higher the more difficult the dragon gets.Scales up mob spawn amount, dragon damage and health aswell as crystal respawn intervals. Note that the difficulty already scales on the playercount involved in the fight, this is a static bonus ontop.default:2, vanilla:0
    "dragonDifficulty": 2
  },
  "crystalRespawnTimeModifier": {
    // Modifies crystal respawn time, 0.5 = spawns twice as fast, 2 = twice as slow. default:1.0
    "crystalRespawnTimeModifier": 1.0
  },
  "lightningExplosionDensity": {
    // Modifies lightning and explosion density, 0.5 = half as many, 2 = twice as many. default:1.0
    "lightningExplosionDensity": 1.0
  },
  "disableLightning": {
    // Disables lightning spawns: default:false
    "disableLightning": false
  },
  "antiflightAbility": {
    // Enables anti-flight ability: default:true
    "antiflightAbility": true
  },
  "explosionImmunity": {
    // Enables explosion damage immunity for the dragon, note that beds are always immune regardless of this setting: default:true
    "explosionImmunity": true
  },
  "dragonHealthModifier": {
    // Sets the dragon health modifier: default:1.0
    "dragonHealthModifier": 1.0
  },
  "dragonDamageModifier": {
    // Sets the dragon damage modifier: default:1.0
    "dragonDamageModifier": 1.0
  },
  "mobSpawnAmountModifier": {
    // Sets the mob spawn amount modifier: default:1.0
    "mobSpawnAmountModifier": 1.0
  },
  "dragonXPModifier": {
    // Sets the XP drop modifier: default:1.0
    "dragonXPModifier": 1.0
  },
  "printDragonPhases": {
    // Prints the dragon phase in chat if enabled: default:false
    "printDragonPhases": false
  },
  "disableDragonAreaSpawns": {
    // Disables mob spawning on the Dragon island during the fight: default:true
    "disableDragonAreaSpawns": true
  },
  "descSpawnEntries": "Below are configuration options for entity spawning, when trying to use nbt append it right after the entity type, e.g. minecraft:zombie{}. Put a backslash in front of all quotation marks",
  "spawnoncrystaldestroy": {
    // List of mobs spawning when a crystal is destroyed at range, intended to be flying or ranged to close the gap: e.g. format :  ["minecraft:zombie", "minecraft:creeper"]
    "spawnoncrystaldestroy": [
      "minecraft:phantom"
    ]
  },
  "spawnoncrystalrespawn": {
    // List of mobs spawning on crystal respawn, intended to be ranged to ward of players from a distance: e.g. format :  ["minecraft:zombie", "minecraft:creeper"]
    "spawnoncrystalrespawn": [
      "minecraft:blaze"
    ]
  },
  "spawnwhilelanded": {
    // List of mobs spawning while the dragon is sitting in the middle, intended to be melee and not vulnerable to ranged: e.g. format :  ["minecraft:zombie", "minecraft:creeper"]
    "spawnwhilelanded": [
      "minecraft:enderman"
    ]
  }
}
